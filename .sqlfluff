[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 100
# Ignora arquivos gerados / dbt packages
ignore = target/,dbt_packages/,logs/

[sqlfluff:rules]
# Ignora regras puramente estilísticas (alinhamento, indentação, comprimento)
exclude_rules = LT01,LT02,LT03,LT05,LT09,ST06,ST07,AL01
